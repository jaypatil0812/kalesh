# Cloudflare Pages response headers (same security headers as vercel.json)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

# Images and sounds: cache 7 days in browsers, serve stale while refreshing
/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# CSS/JS are loaded with ?v= tags in index.html; bump the tag when you change a file
/*.css
  Cache-Control: public, max-age=86400
/*.js
  Cache-Control: public, max-age=86400
/js/*
  Cache-Control: public, max-age=86400

# config.js holds live settings (Supabase URL, login provider). Never cache it, so a settings change
# reaches everyone on their next page load. "! Cache-Control" drops the 1-day rule from /*.js above.
/config.js
  ! Cache-Control
  Cache-Control: no-cache
